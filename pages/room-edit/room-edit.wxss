/* pages/room-edit/room-edit.wxss */
/* 简化美观的房间编辑页面样式 */
page {
  background-color: #f7f8fa;
  padding-bottom: 120rpx;
}

.container {
  min-height: 100vh;
  position: relative;
}

/* 加载状态 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-content {
  text-align: center;
}

.loading-text {
  color: #999;
  font-size: 28rpx;
}

/* 表单滚动区域 */
.form-scroll {
  height: calc(100vh - 120rpx);
  padding: 0 32rpx;
}

/* 表单区块 */
.form-section {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 楼栋信息展示 */
.building-info {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  border: 1rpx solid #e9ecef;
}

.building-info-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.building-info-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.edit-btn {
  background: none;
  border: none;
  padding: 8rpx;
  border-radius: 6rpx;
  background: #007aff;
  color: white;
  font-size: 24rpx;
}

.edit-icon {
  font-size: 24rpx;
}

.building-info-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-item {
  display: flex;
  align-items: center;
}

.info-label {
  font-size: 26rpx;
  color: #666;
  margin-right: 16rpx;
  min-width: 120rpx;
}

.info-value {
  font-size: 26rpx;
  color: #333;
}

/* 楼栋信息编辑 */
.building-edit {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #fff5f5;
  border-radius: 12rpx;
  border: 1rpx solid #ffd6d6;
}

.building-edit-header {
  margin-bottom: 20rpx;
}

.building-edit-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #d32f2f;
}

.building-edit-content {
  margin-bottom: 20rpx;
}

.building-edit-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.action-btn-small {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  border: none;
}

.action-btn-small.cancel {
  background: #f5f5f5;
  color: #666;
}

.action-btn-small.save {
  background: #007aff;
  color: white;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.section-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.section-action {
  background: #1989fa;
  color: #fff;
  border: none;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

/* 表单行和组 */
.form-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.form-row:last-child {
  margin-bottom: 0;
}

.form-group {
  flex: 1;
  margin-bottom: 24rpx;
}

.form-group.half {
  flex: 1;
  margin-bottom: 0;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-label.required::after {
  content: '*';
  color: #ee0a24;
  margin-left: 4rpx;
}

/* 输入框样式 */
.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: #f7f8fa;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #1989fa;
  background: #fff;
}

.form-input.error {
  border-color: #ee0a24;
  background: #fff7f7;
}

.form-input[disabled] {
  background: #f5f5f5;
  color: #999;
}

/* 带单位的输入框 */
.input-with-unit {
  position: relative;
  display: flex;
  align-items: center;
}

.input-with-unit .form-input {
  padding-right: 80rpx;
}

.input-unit {
  position: absolute;
  right: 24rpx;
  font-size: 24rpx;
  color: #999;
}

/* 文本域 */
.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 24rpx;
  background: #f7f8fa;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  resize: none;
}

.form-textarea:focus {
  border-color: #1989fa;
  background: #fff;
}

/* 选择器样式 */
.picker-display {
  height: 80rpx;
  padding: 0 24rpx;
  background: #f7f8fa;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.picker-display.error {
  border-color: #ee0a24;
  background: #fff7f7;
}

.picker-display:empty::before {
  content: attr(placeholder);
  color: #999;
}

/* 单选框组 */
.radio-group {
  display: flex;
  gap: 32rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #333;
}

/* 错误提示 */
.error-text {
  color: #ee0a24;
  font-size: 24rpx;
  margin-top: 8rpx;
  line-height: 1.4;
}

/* 其他费用 */
.other-fees {
  margin-top: 24rpx;
}

.fee-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.fee-item:last-child {
  border-bottom: none;
}

.fee-info {
  flex: 1;
}

.fee-name {
  font-size: 28rpx;
  color: #333;
  margin-right: 16rpx;
}

.fee-amount {
  font-size: 24rpx;
  color: #999;
}

.fee-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  border: none;
}

.action-btn.edit {
  background: #1989fa;
  color: #fff;
}

.action-btn.delete {
  background: #ee0a24;
  color: #fff;
}

.add-fee-btn {
  width: 100%;
  height: 80rpx;
  background: #f7f8fa;
  border: 2rpx dashed #1989fa;
  border-radius: 12rpx;
  color: #1989fa;
  font-size: 28rpx;
  margin-top: 24rpx;
}

/* 设施网格 */
.facility-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.facility-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: #f7f8fa;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  text-align: center;
  transition: all 0.3s;
}

.facility-item.active {
  background: #e7f4ff;
  border-color: #1989fa;
}

.facility-icon {
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.facility-name {
  font-size: 24rpx;
  color: #333;
}

/* 家具标签 */
.furniture-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.furniture-tag {
  padding: 12rpx 20rpx;
  background: #f7f8fa;
  border: 2rpx solid #e8e8e8;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
  transition: all 0.3s;
}

.furniture-tag.active {
  background: #1989fa;
  border-color: #1989fa;
  color: #fff;
}

/* 底部操作按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: #fff;
  border-top: 1rpx solid #e8e8e8;
  display: flex;
  gap: 24rpx;
  z-index: 100;
}

.bottom-actions .action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bottom-actions .action-btn.cancel {
  background: #f7f8fa;
  color: #666;
  border: 2rpx solid #e8e8e8;
}

.bottom-actions .action-btn.copy {
  background: #ff9500;
  color: #fff;
  border: 2rpx solid #ff9500;
}

.bottom-actions .action-btn.save {
  background: #1989fa;
  color: #fff;
  border: 2rpx solid #1989fa;
}

.bottom-actions .action-btn.loading {
  opacity: 0.6;
}

/* 弹窗样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.modal-content {
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  background: #f7f8fa;
  border: none;
  border-radius: 50%;
  font-size: 24rpx;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  max-height: 60vh;
  overflow-y: auto;
  padding: 32rpx;
}

.modal-footer {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #e8e8e8;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
}

.modal-btn.cancel {
  background: #f7f8fa;
  color: #666;
}

.modal-btn.confirm {
  background: #1989fa;
  color: #fff;
}

/* 费用设置 */
.fee-setting {
  space-between: 32rpx;
}

.setting-group {
  margin-bottom: 32rpx;
}

.setting-group:last-child {
  margin-bottom: 0;
}

.setting-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.setting-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.setting-row:last-child {
  margin-bottom: 0;
}

.setting-label {
  flex: 1;
  font-size: 26rpx;
  color: #666;
}

.setting-input {
  width: 120rpx;
  height: 60rpx;
  padding: 0 16rpx;
  background: #f7f8fa;
  border: 1rpx solid #e8e8e8;
  border-radius: 8rpx;
  font-size: 24rpx;
  text-align: center;
  margin-right: 8rpx;
}

.setting-unit {
  font-size: 24rpx;
  color: #999;
  min-width: 60rpx;
}

/* 新增样式 - 批量复制和楼栋管理 */
.form-group.third {
  flex: 1;
}

.bottom-actions .action-btn.copy {
  background: #ff9500;
  color: #fff;
  border: 2rpx solid #ff9500;
}

/* 批量复制弹窗特有样式 */
.modal-overlay.large {
  align-items: flex-start;
  padding-top: 100rpx;
}

.modal-content.large {
  width: 95%;
  max-width: 700rpx;
  max-height: 85vh;
}

.copy-settings {
  margin-bottom: 32rpx;
}

.generate-btn {
  width: 100%;
  height: 80rpx;
  background: #1989fa;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-top: 24rpx;
}

.generated-rooms {
  border-top: 1rpx solid #eee;
  padding-top: 24rpx;
  margin-top: 24rpx;
}

.rooms-header {
  margin-bottom: 16rpx;
}

.rooms-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.rooms-list {
  max-height: 300rpx;
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  padding: 16rpx;
  background: #fafafa;
}

.room-preview {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.room-preview:last-child {
  border-bottom: none;
}

.room-number {
  width: 100rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1989fa;
}

.room-info {
  flex: 1;
  font-size: 24rpx;
  color: #666;
}

/* 楼栋选择区域改进 */
.section-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  margin: -32rpx -32rpx 32rpx -32rpx;
  padding: 32rpx;
  border-radius: 16rpx 16rpx 0 0;
}

.section-action {
  background: rgba(255, 255, 255, 0.2);
  color: white;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 20rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
}

.section-subtitle {
  font-size: 24rpx;
  opacity: 0.7;
  margin-left: 8rpx;
}

/* 表单输入改进 */
.form-input:focus {
  border-color: #667eea;
  background: #fff;
  box-shadow: 0 0 0 2rpx rgba(102, 126, 234, 0.1);
}

.picker-display:active {
  background: #fff;
  border-color: #667eea;
}

.static-text {
  height: 80rpx;
  padding: 0 24rpx;
  background: #f7f8fa;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #888; /* Greyed out text */
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

/* 设施选择改进 */
.facility-item:active {
  transform: scale(0.95);
}

.furniture-tag:active {
  transform: scale(0.95);
}

/* 模态框头部样式改进 */
.modal-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-bottom: none;
}

.modal-close {
  background: rgba(255, 255, 255, 0.2);
  color: white;
  border: none;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  font-size: 32rpx;
}

/* 按钮点击效果 */
.action-btn:active {
  transform: scale(0.98);
}

.modal-btn:active {
  transform: scale(0.98);
}

/* 新增样式 - 提示和优化 */
.picker-display.placeholder {
  color: #999;
  font-style: italic;
}

.building-hint {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 16rpx;
  background: #f0f8ff;
  border-radius: 8rpx;
  border-left: 4rpx solid #1989fa;
}

.hint-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.hint-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

.field-hint {
  margin-top: 8rpx;
}

.field-hint .hint-text {
  font-size: 22rpx;
  color: #999;
}

/* 文本域样式 */
.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #fafafa;
  color: #333;
  box-sizing: border-box;
  resize: none;
  transition: all 0.3s ease;
}

.form-textarea:focus {
  border-color: #667eea;
  background: #fff;
  box-shadow: 0 0 0 2rpx rgba(102, 126, 234, 0.1);
}

.char-count {
  margin-top: 8rpx;
  text-align: right;
  font-size: 22rpx;
  color: #999;
}

/* 设施选择优化 */
.facility-icon {
  font-size: 32rpx;
  margin-bottom: 8rpx;
  transition: all 0.3s ease;
}

.facility-item.active .facility-icon {
  animation: bounce 0.3s ease;
}

@keyframes bounce {
  0%, 20%, 60%, 100% {
    transform: translateY(0);
  }
  40% {
    transform: translateY(-8rpx);
  }
  80% {
    transform: translateY(-4rpx);
  }
}

/* 按钮禁用状态 */
.action-btn[disabled] {
  opacity: 0.5;
  cursor: not-allowed;
}

.action-btn.copy[disabled] {
  background: #ddd;
  border-color: #ddd;
  color: #999;
}

.action-btn.save[disabled] {
  background: #ddd;
  color: #999;
}

/* 模态框优化 */
.modal-btn[disabled] {
  opacity: 0.5;
  cursor: not-allowed;
  background: #f5f5f5;
  color: #ccc;
}

/* 表单组布局优化 */
.form-group {
  margin-bottom: 32rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

/* 响应式适配 */
@media (max-width: 375px) {
  .form-row {
    flex-direction: column;
    gap: 0;
  }
  
  .form-group.half {
    margin-bottom: 24rpx;
  }
  
  .form-group.third {
    margin-bottom: 24rpx;
  }
  
  .facility-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .furniture-tags {
    gap: 8rpx;
  }
  
  .bottom-actions {
    flex-direction: column;
    gap: 16rpx;
  }
  
  .bottom-actions .action-btn {
    width: 100%;
  }
  
  .building-hint {
    flex-direction: column;
    text-align: center;
  }
  
  .hint-icon {
    margin-right: 0;
    margin-bottom: 8rpx;
  }
}