<view class="meter-page">
  <view class="cell-group">
    <view class="cell" hover-class="cell-hover" bindtap="goToBatchMeter">
      <image class="cell-icon" src="/images/bill-active.svg" mode="aspectFit" />
      <view class="cell-content">
        <view class="cell-title">批量抄表</view>
        <view class="cell-desc">按楼栋/房间批量录入水电</view>
      </view>
      <image class="cell-arrow" src="/images/arrow-down.svg" mode="aspectFit" />
    </view>
  </view>

  <view class="cell-group">
    <view class="cell" hover-class="cell-hover" bindtap="goToMeterHistory">
      <image class="cell-icon" src="/images/room.svg" mode="aspectFit" />
      <view class="cell-content">
        <view class="cell-title">抄表记录</view>
        <view class="cell-desc">按楼栋/房间查看历史水电记录</view>
      </view>
      <image class="cell-arrow" src="/images/arrow-down.svg" mode="aspectFit" />
    </view>
  </view>

  <view class="cell-group">
    <view class="cell" hover-class="cell-hover" bindtap="goToBills">
      <image class="cell-icon" src="/images/invoice.svg" mode="aspectFit" />
      <view class="cell-content">
        <view class="cell-title">账单管理</view>
        <view class="cell-desc">查看和管理租金账单</view>
      </view>
      <image class="cell-arrow" src="/images/arrow-down.svg" mode="aspectFit" />
    </view>
  </view>
</view>
