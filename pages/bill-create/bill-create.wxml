<!--pages/bill-create/bill-create.wxml-->
<view class="page">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-container">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 账单预览详情 -->
  <view wx:else class="bill-detail-container">
    <view wx:if="{{billDetail}}" class="bill-content">
      <!-- 头部信息 -->
      <view class="header-section">
        <view class="bill-title">{{billDetail.buildingName}} {{billDetail.roomNumber}}房账单</view>
        <view class="status-badge unpaid">
          {{billDetail.statusText}}
        </view>
      </view>

      <!-- 费用明细 -->
      <view class="fees-section">
        <view class="section-title">费用明细</view>

        <!-- 房租 -->
        <view class="fee-item">
          <view class="fee-info">
            <text class="fee-name">房租</text>
          </view>
          <text class="fee-amount">¥{{billDetail.rentAmount}}</text>
        </view>

        <!-- 水费 -->
        <view class="fee-item">
          <view class="fee-info">
            <text class="fee-name">水费</text>
            <text class="fee-usage">{{billDetail.waterUsage}}吨 × ¥{{billDetail.waterPrice}}/吨</text>
          </view>
          <text class="fee-amount">¥{{billDetail.waterAmount}}</text>
        </view>

        <!-- 电费 -->
        <view class="fee-item">
          <view class="fee-info">
            <text class="fee-name">电费</text>
            <text class="fee-usage">{{billDetail.electricityUsage}}度 × ¥{{billDetail.electricityPrice}}/度</text>
          </view>
          <text class="fee-amount">¥{{billDetail.electricityAmount}}</text>
        </view>

        <!-- 其他费用 -->
        <view wx:if="{{billDetail.cleaningAmount > 0}}" class="fee-item">
          <view class="fee-info">
            <text class="fee-name">卫生费/清洁费</text>
          </view>
          <text class="fee-amount">¥{{billDetail.cleaningAmount}}</text>
        </view>
        <view wx:if="{{billDetail.managementFee > 0}}" class="fee-item">
          <view class="fee-info">
            <text class="fee-name">管理费</text>
          </view>
          <text class="fee-amount">¥{{billDetail.managementFee}}</text>
        </view>
        <view wx:if="{{billDetail.internetFee > 0}}" class="fee-item">
          <view class="fee-info">
            <text class="fee-name">网费</text>
          </view>
          <text class="fee-amount">¥{{billDetail.internetFee}}</text>
        </view>
        <view wx:if="{{billDetail.otherFee > 0}}" class="fee-item">
          <view class="fee-info">
            <text class="fee-name">其他费用</text>
          </view>
          <text class="fee-amount">¥{{billDetail.otherFee}}</text>
        </view>

        <!-- 总计 -->
        <view class="total-section">
          <view class="total-row">
            <text class="total-label">总金额</text>
            <text class="total-amount">¥{{billDetail.totalAmount}}</text>
          </view>
        </view>
      </view>
      
      <!-- 房间信息 -->
      <view class="info-section">
        <view class="section-title">房间信息</view>
        <view class="info-row">
          <text class="label">房间:</text>
          <text class="value">{{billDetail.buildingName}} {{billDetail.roomNumber}}</text>
        </view>
        <view class="info-row">
          <text class="label">租客:</text>
          <text class="value">{{billDetail.tenantName || '未设置'}}</text>
        </view>
        <view class="info-row">
          <text class="label">账单月份:</text>
          <text class="value">{{billDetail.billMonth}}</text>
        </view>
      </view>
      <!-- 抄表信息 -->
      <view wx:if="{{billDetail.meterRecord}}" class="meter-section">
        <view class="section-title">抄表信息</view>
        <view class="info-row">
          <text class="label">上次水表读数:</text>
          <text class="value">{{billDetail.meterRecord.prevWaterReading === undefined ? "-" : billDetail.meterRecord.prevWaterReading}}</text>
        </view>
        <view class="info-row">
          <text class="label">本次水表读数:</text>
          <text class="value">{{billDetail.meterRecord.waterReading}}</text>
        </view>
        <view class="info-row">
          <text class="label">上次电表读数:</text>
          <text class="value">{{billDetail.meterRecord.prevElectricityReading === undefined ? "-" : billDetail.meterRecord.prevElectricityReading}}</text>
        </view>
        <view class="info-row">
          <text class="label">本次电表读数:</text>
          <text class="value">{{billDetail.meterRecord.electricityReading}}</text>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="actions-section">
        <button class="action-btn secondary" bindtap="editRoomFee">
          修改房间费用
        </button>
        <button class="action-btn primary" bindtap="confirmCreateBill">
          确认开单
        </button>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:else class="empty-state">
      <text class="empty-text">账单不存在或无法预览</text>
    </view>
  </view>
</view>
