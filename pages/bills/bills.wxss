/* pages/bills/bills.wxss */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #F7F8FA;
}

/* --- 顶部模块（放入滚动区，改为静态布局） --- */
.header-fixed {
  position: static;
  background-color: #FFFFFF;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
  padding: 15px;
}

/* 选择器容器 */
.selector-container {
  display: flex;
  gap: 15px;
  margin-bottom: 15px;
}

.selector-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.selector-label {
  font-size: 13px;
  color: #646566;
}

.picker-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 12px;
  background-color: #f7f8fa;
  border: 1px solid #ebedf0;
  border-radius: 8px;
  position: relative;
  z-index: 1;
}

.picker-text {
  font-size: 15px;
  color: #323233;
  font-weight: 500;
}

.picker-arrow {
  font-size: 12px;
  color: #969799;
  transform: scale(0.8);
}

/* 搜索框 */
.search-bar-wrapper {
  padding-top: 0;
}
.search-bar {
  display: flex;
  align-items: center;
  background-color: #F7F8FA;
  border-radius: 18px;
  padding: 0 12px;
  height: 36px;
}
.search-icon {
  margin-right: 8px;
}
.search-input {
  flex: 1;
  font-size: 14px;
}

/* --- 可滚动内容区 --- */
.content-scroll { flex: 1; width: 100%; box-sizing: border-box; }

.bill-list {
  padding: 15px;
}

.bill-card-wrapper {
  margin-bottom: 15px;
}

.bill-card {
  background-color: #FFFFFF;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  padding: 15px;
}

.card-title-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 16px;
  font-weight: bold;
}
.room-number { 
  color: #323233; 
}
.payment-status { 
  font-size: 14px; 
  font-weight: normal; 
}
.status-paid { 
  color: #07c160; 
}
.status-unpaid { 
  color: #ff976a; 
}

.divider {
  height: 1px;
  background-color: #EBEDF0;
  margin: 12px 0;
}

.card-info-line {
  display: flex;
  justify-content: space-between;
  font-size: 13px;
  color: #888;
  line-height: 1.6;
}
.info-amount { 
  color: #1989FA;
  font-weight: bold;
  font-size: 16px;
}
.info-label { 
  color: #333; 
}
.info-details { 
  color: #666; 
}
.info-date, .info-due { 
  color: #999; 
  font-size: 12px;
}

/* --- 其他状态 --- */
.empty-state, .loading-more, .no-more {
  text-align: center;
  color: #969799;
  padding: 40px 0;
  font-size: 14px;
}
