<!--pages/bills/bills.wxml-->
<view class="page">
  <!-- 可滚动内容区 -->
  <scroll-view 
    scroll-y 
    class="content-scroll"
    style="padding-top: 0;"
    scroll-with-animation
    enable-back-to-top
    bindscrolltolower="loadMoreBills"
  >
    <!-- 顶部选择与搜索模块（移入滚动区） -->
    <view class="header-fixed">
      <view class="selector-container">
        <!-- 账单月份选择 -->
        <view class="selector-item">
          <text class="selector-label">账单月份</text>
          <view>
            <picker mode="date" fields="month" value="{{selectedMonth}}" bindchange="onMonthChange">
              <view class="picker-content">
                <text class="picker-text">{{displayMonth}}</text>
                <text class="picker-arrow">▼</text>
              </view>
            </picker>
          </view>
        </view>
        
        <!-- 选择楼栋 -->
        <view class="selector-item">
          <text class="selector-label">选择楼栋</text>
          <view wx:if="{{buildingList.length > 0}}">
            <picker 
              class="building-picker"
              bindchange="onBuildingChange" 
              value="{{selectedBuildingIndex}}" 
              range="{{buildingList}}" 
              range-key="name"
            >
              <view class="picker-content">
                <text class="picker-text">{{currentBuilding.name || '请选择楼栋'}}</text>
                <text class="picker-arrow">▼</text>
              </view>
            </picker>
          </view>
          <view wx:else class="picker-content">
            <text class="picker-text">暂无楼栋</text>
          </view>
        </view>
      </view>
      
      <!-- 搜索框 -->
      <view class="search-bar-wrapper">
        <view class="search-bar">
          <icon class="search-icon" type="search" size="16"></icon>
          <input 
            class="search-input"
            placeholder="搜索房间号" 
            value="{{searchKeyword}}" 
            bindinput="onSearchInput"
            confirm-type="search"
            bindconfirm="onSearchConfirm"
          />
        </view>
      </view>
    </view>

    <view class="bill-list">
      <block wx:if="{{filteredBillList.length > 0}}">
        <view 
          class="bill-card-wrapper" 
          wx:for="{{filteredBillList}}" 
          wx:key="id"
          bindtap="gotoBillDetail"
          data-bill="{{item}}"
        >
          <view class="bill-card">
            <view class="card-title-line">
              <text class="room-number">{{item.roomNumber}}室</text>
              <view class="status-tags">
                <text class="payment-status {{item.isUnbilled ? 'status-unpaid' : 'status-paid'}}">
                  {{item.isUnbilled ? '未开单' : '已开单'}}
                </text>
                <text class="payment-status {{item.isPaid ? 'status-paid' : 'status-unpaid'}}" style="margin-left: 8rpx;">
                  {{item.isPaid ? '已收款' : '未收款'}}
                </text>
              </view>
            </view>
            <view class="divider"></view>
            <view class="card-info-line">
              <text class="info-label">房租总额</text>
              <text class="info-amount">¥{{item.totalAmount}}</text>
            </view>
            <view class="card-info-line">
              <text class="info-details">房租: ¥{{item.rent}}</text>
              <text class="info-date">{{item.billDate}}</text>
            </view>
            <view class="card-info-line" wx:if="{{item.waterFee || item.electricFee}}">
              <text class="info-details">
                <text wx:if="{{item.waterFee}}">水费: ¥{{item.waterFee}} </text>
                <text wx:if="{{item.electricFee}}">电费: ¥{{item.electricFee}}</text>
              </text>
              <text class="info-due">到期: {{item.dueDate}}</text>
            </view>
          </view>
        </view>
      </block>
      <block wx:else>
        <view class="empty-state">
          <text>{{loading ? '加载中...' : '暂无账单数据'}}</text>
        </view>
      </block>
    </view>
    
    <!-- 加载更多提示 -->
    <view class="loading-more" wx:if="{{loading && filteredBillList.length > 0}}">
      <text>加载中...</text>
    </view>
    <view class="no-more" wx:if="{{!hasMore && filteredBillList.length > 0}}">
      <text>没有更多了</text>
    </view>
  </scroll-view>

</view>
