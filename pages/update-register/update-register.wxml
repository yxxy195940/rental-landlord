<!--pages/update-register/update-register.wxml-->
<view class="page">
  <view wx:if="{{loading}}" class="loading-state">
    <text>加载中...</text>
  </view>

  <view wx:else class="content">
    <!-- 房间信息 -->
    <view class="form-section" wx:if="{{roomInfo}}">
      <view class="section-header">
        <text class="section-icon">🏠</text>
        <text class="section-title">房间信息</text>
      </view>
      <view class="info-card">
        <view class="info-row">
          <text class="label">房间号</text>
          <text class="value">{{roomInfo.roomNumber}}室</text>
        </view>
        <view class="info-row">
          <text class="label">月租金</text>
          <text class="value">¥{{roomInfo.monthlyRent || 0}}</text>
        </view>
        <view class="info-row">
          <text class="label">入住时间</text>
          <text class="value">{{roomInfo.rentStartDate || '--'}}</text>
        </view>
      </view>
    </view>

    <!-- 租客信息 -->
    <view class="form-section">
      <view class="section-header">
        <text class="section-icon">👤</text>
        <text class="section-title">租客信息</text>
      </view>
      <view class="form-card">
        <view class="form-row">
          <view class="form-item">
            <text class="label">租客姓名</text>
            <input 
              class="input {{errors.tenantName ? 'error' : ''}}"
              placeholder="可选填写"
              value="{{tenantName}}"
              data-field="tenantName"
              bindinput="onInputChange"
              maxlength="20"
            />
          </view>
          <text class="error-text" wx:if="{{errors.tenantName}}">{{errors.tenantName}}</text>
        </view>
        
        <view class="form-row">
          <view class="form-item">
            <text class="label">手机号</text>
            <input 
              class="input {{errors.tenantPhone ? 'error' : ''}}"
              placeholder="可选填写"
              value="{{tenantPhone}}"
              data-field="tenantPhone"
              bindinput="onInputChange"
              type="number"
              maxlength="11"
            />
          </view>
          <text class="error-text" wx:if="{{errors.tenantPhone}}">{{errors.tenantPhone}}</text>
        </view>
      </view>
    </view>

    <!-- 水电表信息 -->
    <view class="form-section">
      <view class="section-header">
        <text class="section-icon">💧</text>
        <text class="section-title">水电表信息</text>
      </view>
      <view class="form-card">
        <view class="form-row">
          <view class="form-item">
            <text class="label">当前水表读数</text>
            <view class="input-with-unit">
              <input 
                class="input {{errors.currentWaterReading ? 'error' : ''}}"
                placeholder="当前水表读数"
                value="{{currentWaterReading}}"
                data-field="currentWaterReading"
                bindinput="onInputChange"
                type="digit"
              />
              <text class="unit">吨</text>
            </view>
          </view>
          <text class="error-text" wx:if="{{errors.currentWaterReading}}">{{errors.currentWaterReading}}</text>
        </view>
        
        <view class="form-row">
          <view class="form-item">
            <text class="label">当前电表读数</text>
            <view class="input-with-unit">
              <input 
                class="input {{errors.currentElectricityReading ? 'error' : ''}}"
                placeholder="当前电表读数"
                value="{{currentElectricityReading}}"
                data-field="currentElectricityReading"
                bindinput="onInputChange"
                type="digit"
              />
              <text class="unit">度</text>
            </view>
          </view>
          <text class="error-text" wx:if="{{errors.currentElectricityReading}}">{{errors.currentElectricityReading}}</text>
        </view>
        
        <view class="form-row">
          <view class="form-item">
            <text class="label">记录日期</text>
            <picker 
              mode="date" 
              value="{{meterDate}}"
              data-field="meterDate"
              bindchange="onDateChange">
              <view class="picker-display {{errors.meterDate ? 'error' : ''}}">
                {{meterDate || '请选择记录日期'}}
              </view>
            </picker>
          </view>
          <text class="error-text" wx:if="{{errors.meterDate}}">{{errors.meterDate}}</text>
        </view>
      </view>
    </view>

    <!-- 提示信息 -->
    <view class="tips-card">
      <view class="tips-icon">💡</view>
      <view class="tips-content">
        <text class="tips-title">更新说明</text>
        <text class="tips-item">• 租客姓名和手机号为可选信息</text>
        <text class="tips-item">• 水电表读数用于账单计算</text>
        <text class="tips-item">• 未填写的信息将显示为"未填写"</text>
      </view>
    </view>
  </view>

  <!-- 底部操作按钮 -->
  <view class="footer-actions" wx:if="{{!loading}}">
    <button class="cancel-btn" bindtap="cancel">取消</button>
    <button 
      class="confirm-btn {{submitting ? 'disabled' : ''}}" 
      bindtap="confirmUpdate"
      disabled="{{submitting}}">
      {{submitting ? '更新中...' : '确认更新'}}
    </button>
  </view>
</view>