/* pages/roomDetail/roomDetail.wxss */
.page {
  background-color: #f7f8fa;
  min-height: 100vh;
  padding-bottom: 180rpx; /* 增加底部间距，确保内容不被按钮遮挡 */
}

.loading-state, .error-state {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  height: 400rpx;
  color: #969799;
}

.error-state button {
  margin-top: 32rpx;
  padding: 16rpx 32rpx;
  background-color: #1989fa;
  color: white;
  border: none;
  border-radius: 8rpx;
}

.content {
  padding: 32rpx;
}

/* 信息区域 */
.info-section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.section-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.header-action {
  font-size: 24rpx;
  color: #1989fa;
  padding: 8rpx 16rpx;
  background: rgba(25, 137, 250, 0.1);
  border-radius: 8rpx;
  border: 1rpx solid rgba(25, 137, 250, 0.3);
}

/* 信息卡片 */
.info-card {
  background-color: white;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 房间头部信息 */
.room-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.room-number {
  font-size: 48rpx;
  font-weight: 600;
  color: #333;
}

.status-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-badge.status-1 {
  background: linear-gradient(135deg, #fff3cd, #ffeaa7);
  color: #b8860b;
}

.status-badge.status-2 {
  background: linear-gradient(135deg, #d4edda, #c3e6cb);
  color: #155724;
}

/* 信息网格 */
.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 32rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
}

.label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.value {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.value.highlight {
  color: #ee0a24;
  font-weight: 600;
}

.value.placeholder {
  color: #ccc;
  font-style: italic;
  font-weight: normal;
}

/* 租客信息 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f9f9f9;
}

.info-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.value-with-action {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-link {
  color: #1989fa;
  font-size: 24rpx;
}

/* 水电信息 */
.meter-info {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.meter-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx dashed #eee;
}

.meter-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.meter-value {
  text-align: right;
}

.meter-value .date {
  display: block;
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 底部操作按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: #fff;
  border-top: 1rpx solid #e8e8e8;
  display: flex;
  gap: 24rpx;
  z-index: 100;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}

.bottom-actions .action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bottom-actions .action-btn.cancel {
  background: #f7f8fa;
  color: #666;
  border: 2rpx solid #e8e8e8;
}

.bottom-actions .action-btn.copy {
  background: #ff9500;
  color: #fff;
  border: 2rpx solid #ff9500;
}

.bottom-actions .action-btn.save {
  background: #1989fa;
  color: #fff;
  border: 2rpx solid #1989fa;
}

.bottom-actions .action-btn.loading {
  opacity: 0.6;
}

/* 弹窗样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.modal-content {
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-content.large {
  width: 95%;
  max-width: 700rpx;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  width: 52rpx;
  height: 52rpx;
  background: #ffffff;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 32rpx;
}

.modal-footer {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #e8e8e8;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn.cancel {
  background: #f7f8fa;
  color: #666;
}

.modal-btn.confirm {
  background: #1989fa;
  color: #fff;
}

/* 表单样式 */
.form-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.form-group {
  flex: 1;
  margin-bottom: 24rpx;
}

.form-group.half {
  flex: 1;
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: #f7f8fa;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.input-with-unit {
  position: relative;
  display: flex;
  align-items: center;
}

.input-with-unit .form-input {
  padding-right: 80rpx;
}

.input-unit {
  position: absolute;
  right: 24rpx;
  font-size: 24rpx;
  color: #999;
}

.checkbox-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 80rpx;
}

.generate-btn {
  width: 100%;
  height: 80rpx;
  background: #f0f9ff;
  color: #1989fa;
  border: 2rpx solid #1989fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 生成的房间列表 */
.generated-rooms {
  margin-top: 32rpx;
  border-top: 1rpx dashed #eee;
  padding-top: 32rpx;
}

.rooms-header {
  margin-bottom: 16rpx;
}

.rooms-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.rooms-list {
  max-height: 400rpx;
}

.rooms-columns {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.rooms-column-left {
  width: 160rpx;
}

.rooms-column-right {
  flex: 1;
  display: flex;
  gap: 16rpx;
}

.rooms-column-title {
  flex: 1;
  margin-bottom: 0;
  text-align: left;
  padding-left: 16rpx;
}

.room-preview {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: #f7f8fa;
  border-radius: 8rpx;
}

.room-summary {
  width: 160rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.room-summary-number {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.room-summary-rent {
  font-size: 24rpx;
  color: #666;
}

.room-preview .room-number {
  width: 120rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.room-inputs {
  flex: 1;
  display: flex;
  gap: 16rpx;
}

.list-input {
  flex: 1;
  height: 64rpx;
  background: #fff;
  border: 1rpx solid #e8e8e8;
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
}
