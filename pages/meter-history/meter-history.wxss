page,
.meter-history-page {
  background: #f6f7fb;
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.page-header {
  margin-bottom: 32rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1d2129;
  display: block;
}

.page-subtitle {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #86909c;
  display: block;
}

.selector-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(25, 137, 250, 0.08);
  margin-bottom: 32rpx;
}

.selector-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}

.selector-row:last-child {
  border-bottom: none;
}

.selector-label {
  font-size: 30rpx;
  color: #4e5969;
  font-weight: 600;
}

.selector-picker {
  flex: 1;
  text-align: right;
}

.selector-value {
  font-size: 32rpx;
  color: #1d2129;
  font-weight: 600;
}

.selector-room {
  color: #005cff;
}

.record-section {
  min-height: 400rpx;
}

.history-tabs {
  display: flex;
  background: #e4ebff;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.record-room-label {
  font-size: 30rpx;
  color: #1d2129;
  font-weight: 600;
  margin-bottom: 18rpx;
}

.tab-btn {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  padding: 18rpx 0;
  border-radius: 999rpx;
  color: #4e5969;
  transition: all 0.2s;
}

.tab-btn.active {
  background: #005cff;
  color: #ffffff;
  font-weight: 600;
}

.table-wrapper {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 33, 109, 0.08);
  overflow: hidden;
}

.table-row {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid #f0f1f5;
}

.table-row:last-child {
  border-bottom: none;
}

.table-row.header {
  background: #f7f9ff;
  font-weight: 600;
  color: #1d2129;
}

.col-index {
  width: 120rpx;
  font-size: 32rpx;
  color: #1d2129;
}

.col-read {
  flex: 1;
  font-size: 34rpx;
  color: #005cff;
  font-weight: 600;
}

.col-time {
  flex: 1.5;
  font-size: 28rpx;
  color: #4e5969;
  text-align: right;
}

.list-status {
  text-align: center;
  font-size: 28rpx;
  color: #1d2129;
  padding: 20rpx 0;
}

.list-status.muted {
  color: #c0c4cc;
}

.empty-state {
  margin-top: 160rpx;
  text-align: center;
}

.empty-text {
  font-size: 30rpx;
  color: #a0a5b1;
}
