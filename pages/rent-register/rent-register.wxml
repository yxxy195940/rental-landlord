<!--pages/rent-register/rent-register.wxml-->
<view class="page">
  <view wx:if="{{loading}}" class="loading-state">
    <text>加载中...</text>
  </view>

  <view wx:else class="content">

      <!-- 抄录当前表数 -->
      <view class="form-section">
      <view class="section-header">
        <text class="section-icon">💧</text>
        <text class="section-title">抄录当前表数</text>
        <text class="section-subtitle">(用作基数)</text>
      </view>
      <view class="form-card">
        <view class="form-row">
          <view class="form-item">
            <text class="label">当前水表</text>
            <view class="input-with-unit">
              <input 
                class="input {{errors.currentWaterReading ? 'error' : ''}}"
                placeholder="请输入当前水表读数"
                value="{{currentWaterReading}}"
                data-field="currentWaterReading"
                bindinput="onInputChange"
                type="digit"
              />
              <text class="unit">吨</text>
            </view>
          </view>
          <text class="error-text" wx:if="{{errors.currentWaterReading}}">{{errors.currentWaterReading}}</text>
        </view>
        
        <view class="form-row">
          <view class="form-item">
            <text class="label">当前电表</text>
            <view class="input-with-unit">
              <input 
                class="input {{errors.currentElectricityReading ? 'error' : ''}}"
                placeholder="请输入当前电表读数"
                value="{{currentElectricityReading}}"
                data-field="currentElectricityReading"
                bindinput="onInputChange"
                type="digit"
              />
              <text class="unit">度</text>
            </view>
          </view>
          <text class="error-text" wx:if="{{errors.currentElectricityReading}}">{{errors.currentElectricityReading}}</text>
        </view>
        
        <view class="form-row">
          <view class="form-item">
            <text class="label required">记录日期</text>
            <picker 
              mode="date" 
              value="{{meterDate}}"
              data-field="meterDate"
              bindchange="onDateChange">
              <view class="picker-display {{errors.meterDate ? 'error' : ''}}">
                {{meterDate || '请选择记录日期'}}
              </view>
            </picker>
          </view>
          <text class="error-text" wx:if="{{errors.meterDate}}">{{errors.meterDate}}</text>
        </view>
      </view>
    </view>

    <!-- 租赁信息 -->
    <view class="form-section">
      <view class="section-header">
        <text class="section-icon">📑</text>
        <text class="section-title">租赁信息</text>
      </view>
      <view class="form-card">
        <view class="form-row">
          <view class="form-item">
            <text class="label required">起租日</text>
            <picker mode="date" value="{{rentStartDate}}" data-field="rentStartDate" bindchange="onDateChange">
              <view class="picker-display {{errors.rentStartDate ? 'error' : ''}}">
                {{rentStartDate || '请选择日期'}}
              </view>
            </picker>
          </view>
        </view>
        <view class="form-row">
          <view class="form-item">
            <text class="label">到期日</text>
            <picker mode="date" value="{{contractEndDate}}" data-field="contractEndDate" bindchange="onDateChange">
              <view class="picker-display {{errors.contractEndDate ? 'error' : ''}}">
                {{contractEndDate || '可选，便于提醒'}}
              </view>
            </picker>
          </view>
          <text class="error-text" wx:if="{{errors.contractEndDate}}">{{errors.contractEndDate}}</text>
        </view>
        <view class="form-row">
          <view class="form-item">
            <text class="label">交租日</text>
            <view class="input-with-unit">
              <input
                class="input {{errors.rentDueDay ? 'error' : ''}}"
                placeholder="1-31"
                value="{{rentDueDay}}"
                data-field="rentDueDay"
                bindinput="onInputChange"
                type="number"
                maxlength="2"
              />
              <text class="unit">号</text>
            </view>
          </view>
          <text class="error-text" wx:if="{{errors.rentDueDay}}">{{errors.rentDueDay}}</text>
        </view>
        <view class="form-row">
          <view class="form-item">
            <text class="label required">月租金</text>
            <view class="input-with-unit">
              <input
                class="input {{errors.monthlyRent ? 'error' : ''}}"
                placeholder="元/月"
                value="{{monthlyRent}}"
                data-field="monthlyRent"
                bindinput="onInputChange"
                type="digit"
              />
              <text class="unit">元</text>
            </view>
          </view>
          <text class="error-text" wx:if="{{errors.monthlyRent}}">{{errors.monthlyRent}}</text>
        </view>
        <view class="form-row">
          <view class="form-item">
            <text class="label">押金</text>
            <view class="input-with-unit">
              <input
                class="input"
                placeholder="押金金额"
                value="{{deposit}}"
                data-field="deposit"
                bindinput="onInputChange"
                type="digit"
              />
              <text class="unit">元</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 费用设置 -->
    <view class="form-section">
      <view class="section-header">
        <text class="section-icon">💰</text>
        <text class="section-title">杂费设置</text>
      </view>
      <view class="form-card">
        <view class="form-row">
          <view class="form-item">
            <text class="label">卫生费</text>
            <view class="input-with-unit">
              <input class="input" placeholder="0" value="{{sanitationFee}}" data-field="sanitationFee" bindinput="onInputChange" type="digit" />
              <text class="unit">元/月</text>
            </view>
          </view>
        </view>
        <view class="form-row">
          <view class="form-item">
            <text class="label">管理费</text>
            <view class="input-with-unit">
              <input class="input" placeholder="0" value="{{managementFee}}" data-field="managementFee" bindinput="onInputChange" type="digit" />
              <text class="unit">元/月</text>
            </view>
          </view>
        </view>
        <view class="form-row">
          <view class="form-item">
            <text class="label">网费</text>
            <view class="input-with-unit">
              <input class="input" placeholder="0" value="{{internetFee}}" data-field="internetFee" bindinput="onInputChange" type="digit" />
              <text class="unit">元/月</text>
            </view>
          </view>
        </view>
        <view class="form-row">
          <view class="form-item">
            <text class="label">其他</text>
            <view class="input-with-unit">
              <input class="input" placeholder="0" value="{{otherFee}}" data-field="otherFee" bindinput="onInputChange" type="digit" />
              <text class="unit">元/月</text>
            </view>
          </view>
        </view>
        <view class="form-row">
          <view class="form-item">
            <text class="label">备注</text>
            <textarea class="textarea" placeholder="合同条款补充" value="{{remark}}" data-field="remark" bindinput="onInputChange" maxlength="200" />
          </view>
        </view>
      </view>
    </view>

    <!-- 租客信息 -->
    <view class="form-section">
      <view class="section-header">
        <text class="section-icon">👤</text>
        <text class="section-title">租客信息</text>
      </view>
      <view class="form-card">
        <view class="form-row">
          <view class="form-item">
            <text class="label">姓名</text>
            <input 
              class="input {{errors.tenantName ? 'error' : ''}}"
              placeholder="可选填写"
              value="{{tenantName}}"
              data-field="tenantName"
              bindinput="onInputChange"
            />
          </view>
          <text class="error-text" wx:if="{{errors.tenantName}}">{{errors.tenantName}}</text>
        </view>
        
        <view class="form-row">
          <view class="form-item">
            <text class="label">手机号</text>
            <input 
              class="input {{errors.tenantPhone ? 'error' : ''}}"
              placeholder="可选填写"
              value="{{tenantPhone}}"
              data-field="tenantPhone"
              bindinput="onInputChange"
              type="number"
              maxlength="11"
            />
          </view>
          <text class="error-text" wx:if="{{errors.tenantPhone}}">{{errors.tenantPhone}}</text>
        </view>
        
        <view class="form-row">
          <view class="form-item">
            <text class="label">身份证号</text>
            <input 
              class="input"
              placeholder="可选填写"
              value="{{tenantIdCard}}"
              data-field="tenantIdCard"
              bindinput="onInputChange"
              maxlength="18"
            />
          </view>
        </view>
      </view>
    </view>


    <!-- 提示信息 -->
    <view class="tip-card">
      <view class="tip-icon">💡</view>
      <view class="tip-content">
        <text class="tip-title">出租后将自动：</text>
        <text class="tip-item">• 房间状态改为"已出租"</text>
        <text class="tip-item">• 设置水电表基数</text>
        <text class="tip-item">• 创建租客档案</text>
      </view>
    </view>
  </view>

  <!-- 底部操作按钮 -->
  <view class="footer-actions">
    <button class="cancel-btn" bindtap="cancel">取消</button>
    <button 
      class="confirm-btn {{submitting ? 'disabled' : ''}}" 
      bindtap="confirmRent"
      disabled="{{submitting}}">
      {{submitting ? '处理中...' : '确认出租'}}
    </button>
  </view>
</view>
