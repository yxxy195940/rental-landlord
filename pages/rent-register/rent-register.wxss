/* pages/rent-register/rent-register.wxss */
.page {
  background-color: #f7f8fa;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200rpx;
  color: #666;
}

.content {
  padding: 32rpx;
}

/* 表单区域 */
.form-section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  gap: 8rpx;
}

.section-icon {
  font-size: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.section-subtitle {
  font-size: 24rpx;
  color: #666;
  margin-left: auto;
}

.form-card {
  background-color: white;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.form-row {
  margin-bottom: 32rpx;
}

.form-row:last-child {
  margin-bottom: 0;
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.label.required::after {
  content: '*';
  color: #ff4757;
  margin-left: 4rpx;
}

.input {
  background-color: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  transition: border-color 0.2s ease;
}

.input:focus {
  border-color: #1989fa;
  background-color: white;
}

.input.error {
  border-color: #ff4757;
  background-color: #fff5f5;
}

.input-with-unit {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.input-with-unit .input {
  flex: 1;
}

.unit {
  font-size: 24rpx;
  color: #666;
  white-space: nowrap;
}

.textarea {
  background-color: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  min-height: 120rpx;
  transition: border-color 0.2s ease;
}

.textarea:focus {
  border-color: #1989fa;
  background-color: white;
}

.picker-display {
  background-color: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  transition: border-color 0.2s ease;
}

.picker-display.error {
  border-color: #ff4757;
  background-color: #fff5f5;
}

.error-text {
  font-size: 24rpx;
  color: #ff4757;
  margin-top: 8rpx;
}

/* 提示卡片 */
.tip-card {
  background: linear-gradient(135deg, #e3f2fd, #f3e5f5);
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 32rpx;
}

.tip-icon {
  font-size: 32rpx;
  margin-top: 4rpx;
}

.tip-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

/* 底部操作按钮 */
.footer-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: white;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #e9ecef;
  display: flex;
  gap: 16rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.cancel-btn {
  flex: 1;
  background-color: #f8f9fa;
  color: #666;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.cancel-btn:active {
  background-color: #e9ecef;
}

.confirm-btn {
  flex: 2;
  background-color: #1989fa;
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.confirm-btn:active {
  background-color: #1976d2;
}

.confirm-btn.disabled {
  background-color: #ccc;
  color: #999;
}

/* 响应式适配 */
@media (max-width: 375px) {
  .content {
    padding: 24rpx;
  }
  
  .form-card {
    padding: 20rpx;
  }
  
  .input,
  .textarea,
  .picker-display {
    padding: 20rpx;
  }
  
  .footer-actions {
    padding: 20rpx 24rpx;
  }
}

/* 暗黑模式适配 */
@media (prefers-color-scheme: dark) {
  .page {
    background-color: #1a1a1a;
  }
  
  .form-card {
    background-color: #2d2d2d;
  }
  
  .label {
    color: #fff;
  }
  
  .input,
  .textarea,
  .picker-display {
    background-color: #404040;
    border-color: #555;
    color: #fff;
  }
  
  .tip-card {
    background: linear-gradient(135deg, #2d3748, #4a5568);
  }
  
  .tip-title {
    color: #fff;
  }
  
  .tip-item {
    color: #cbd5e0;
  }
  
  .footer-actions {
    background-color: #2d2d2d;
    border-color: #555;
  }
  
  .cancel-btn {
    background-color: #404040;
    color: #cbd5e0;
    border-color: #555;
  }
}