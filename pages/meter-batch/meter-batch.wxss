/* pages/meter-batch/meter-batch.wxss */
page {
  background-color: #F7F8FA;
  --van-tabs-card-active-color: #1989fa;
  --van-field-input-text-color: #1989fa;
  --van-field-input-font-weight: bold;
  --van-sticky-z-index: 99;
}

.page-container { }

/* --- 顶部固定区域 --- */
.header-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  z-index: 1000; /* ensure header sits above sticky tabs for picker tap */
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
}

/* 选择器容器 */
.selector-container {
  display: flex;
  gap: 16px;
  padding: 12px 16px;
}

.selector-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.selector-label {
  font-size: 13px;
  color: #646566;
}

.picker-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 10px;
  background-color: #f7f8fa;
  border: 1px solid #ebedf0;
  border-radius: 6px;
  position: relative;
  z-index: 1; /* lift picker tap target above surrounding layers */
}

.picker-text {
  font-size: 15px;
  color: #323233;
  font-weight: 500;
}

.picker-arrow {
  font-size: 12px;
  color: #969799;
  transform: scale(0.8);
}

/* --- 表单区域 --- */
.form-wrapper {
  padding: 12px 16px 0;
}

.form-container {
  background-color: #fff;
  border: 1px solid #ebedf0;
  border-radius: 8px;
  overflow: hidden;
}

.form-header {
  display: flex;
  padding: 12px 16px;
  background-color: #fafafa;
  border-bottom: 1px solid #ebedf0;
}

.header-item {
  font-size: 14px;
  color: #646566;
  text-align: center;
  font-weight: bold;
}

.form-body {
  display: flex;
  flex-direction: column;
}

.form-row {
  display: flex;
  align-items: center;
  border-bottom: 1px solid #ebedf0;
  min-height: 50px;
}

.form-row:last-child {
  border-bottom: none;
}

.cell-item {
  font-size: 16px;
  color: #323233;
  text-align: center;
  padding: 4px 0;
}

.room-number {
  flex: 2;
  font-weight: bold;
}

.last-reading {
  flex: 2;
}

.current-reading {
  flex: 3;
}

.current-reading .van-field {
  padding: 0;
}

/* 读数单元格：读数值 + 右侧时间 */
.last-reading,
.current-reading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.reading-value {
  color: #323233;
}

.reading-input {
  flex: 1;
}

.reading-time {
  margin-left: 8px;
  white-space: nowrap;
  color: #969799;
  font-size: 12px;
}

/* 状态容器 */
.status-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40px 0;
  color: #969799;
  font-size: 14px;
}

/* --- 底部固定操作栏 --- */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 10px 16px 20px; /* 适配iPhone等底部安全区 */
  background-color: #fff;
  box-shadow: 0 -1px 4px rgba(0, 0, 0, 0.05);
  z-index: 100;
  display: flex;
  gap: 10px;
}

.bottom-bar .van-button {
  border-radius: 8px;
}

.view-bills-btn,
.save-btn {
  flex: 1;
}

.primary-btn {
  background-color: #1989fa;
  color: #fff;
}

.action-btn {
  flex: 1;
  margin: 0 5px;
  border-radius: 20px;
}

/* 底部占位符 */
.content-placeholder {
  height: 20px; /* 预估值, 和 bottom-bar 高度相关 */
}

/* --- 上期/本期最后抄表时间条 --- */
.meter-timebar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 12px 10px;
  color: #646566;
  font-size: 12px;
}

.time-item {
  display: flex;
  align-items: baseline;
  gap: 8px;
}

.time-label {
  color: #969799;
}

.time-value {
  color: #323233;
  font-weight: 500;
}

.divider {
  width: 1px;
  height: 16px;
  background-color: #ebedf0;
}
