<!--pages/meter-batch/meter-batch.wxml-->
<view class="page-container" style="padding-top: {{headerHeight}}px;">
  <!-- 顶部固定区域 (仅选择器) -->
  <view id="header-fixed" class="header-fixed">
    <view class="selector-container">
      <!-- 抄表月份选择 -->
      <view class="selector-item">
        <text class="selector-label">抄表月份</text>
        <picker mode="date" fields="month" value="{{selectedMonth}}" bindchange="onMonthChange">
          <view class="picker-content">
            <text class="picker-text">{{ displayMonth || '选择月份' }}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>

      <!-- 选择楼栋 -->
      <view class="selector-item">
        <text class="selector-label">选择楼栋</text>
        <picker mode="selector"
                range="{{ buildings }}"
                range-key="name"
                value="{{ buildingIndex }}"
                bindchange="onBuildingChange"
                disabled="{{ buildings.length === 0 }}">
          <view class="picker-content">
            <text class="picker-text">{{ buildings.length ? buildings[buildingIndex].name : '暂无楼栋' }}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>

    </view>
    
  </view>
  <!-- 底部内容垫片, 防止被 bottom-bar 遮挡 -->
  <view class="content-placeholder"></view>
  <!-- Tabs 和 表单内容 (页面主体，可滚动) -->
  <van-tabs active="{{ activeTab }}" bind:change="onTabChange" type="card" color="#1989fa" sticky offset-top="{{ headerHeight }}">
    <van-tab title="水表" name="water">
      <view class="form-wrapper">
        <view class="form-container">
          <view class="form-header">
            <text class="header-item room-number">房间号</text>
            <text class="header-item last-reading">上期读数</text>
            <text class="header-item current-reading">本期读数</text>
          </view>
          <view class="form-body">
            <view class="form-row" wx:for="{{rooms}}" wx:key="_id">
              <text class="cell-item room-number">{{item.roomName}}</text>
              <view class="cell-item last-reading">
                <text class="reading-value">{{item.lastMeterReading.water}}</text>
                <text class="reading-time">{{ item.previousMeterTimeText || '--' }}</text>
              </view>
              <view class="cell-item current-reading">
                <view class="reading-input">
                  <van-field
                    value="{{ item.currentMeterReading.water }}"
                    type="digit"
                    placeholder="输入读数"
                    border="{{ false }}"
                    input-align="center"
                    bind:input="onInput"
                    data-room-id="{{item._id}}"
                    data-field="water"
                  />
                </view>
                <text class="reading-time">{{ item.currentMeterTimeText || '--' }}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </van-tab>
    <van-tab title="电表" name="electricity">
      <view class="form-wrapper">
        <view class="form-container">
          <view class="form-header">
            <text class="header-item room-number">房间号</text>
            <text class="header-item last-reading">上期读数</text>
            <text class="header-item current-reading">本期读数</text>
          </view>
          <view class="form-body">
            <view class="form-row" wx:for="{{rooms}}" wx:key="_id">
              <text class="cell-item room-number">{{item.roomName}}</text>
              <view class="cell-item last-reading">
                <text class="reading-value">{{item.lastMeterReading.electricity}}</text>
                <text class="reading-time">{{ item.previousMeterTimeText || '--' }}</text>
              </view>
              <view class="cell-item current-reading">
                <view class="reading-input">
                  <van-field
                    value="{{ item.currentMeterReading.electricity }}"
                    type="digit"
                    placeholder="输入读数"
                    border="{{ false }}"
                    input-align="center"
                    bind:input="onInput"
                    data-room-id="{{item._id}}"
                    data-field="electricity"
                  />
                </view>
                <text class="reading-time">{{ item.currentMeterTimeText || '--' }}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </van-tab>
  </van-tabs>

  <!-- 加载中或空状态 -->
  <view wx:if="{{loading}}" class="status-container">
    <van-loading size="24px">加载中...</van-loading>
  </view>
  <view wx:if="{{!loading && rooms.length === 0}}" class="status-container">
    <text>没有需要抄表的房间</text>
  </view>

  <!-- 底部内容垫片, 防止被 bottom-bar 遮挡 -->
  <view class="content-placeholder"></view>

  <!-- 底部固定操作栏 -->
  <view class="bottom-bar">
    <van-button type="default" block bind:click="onViewBills" class="view-bills-btn">查看账单</van-button>
    <button class="action-btn primary-btn" bindtap="onSave">保存全部</button>
  </view>

  <van-toast id="van-toast" />
</view>
