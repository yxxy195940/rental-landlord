/* pages/my/my.wxss */
.page {
  background-color: #f7f8fa;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

/* 顶部个人信息区域（仿微信我的页） */
.profile-card {
  display: flex;
  align-items: center;
  padding: 20px 16px;
  background-color: #ffffff;
}

.avatar-btn {
  width: 64px;
  height: 64px;
  padding: 0;
  border-radius: 8px;
  overflow: hidden;
  margin-right: 12px;
  background: transparent;
  border: none;
}

.avatar {
  width: 64px;
  height: 64px;
  border-radius: 8px;
}

.profile-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 18px;
  font-weight: 600;
  color: #111;
  border: none;
  background: transparent;
}

.nickname::placeholder {
  color: #c8c9cc;
}

.uid {
  margin-top: 4px;
  font-size: 12px;
  color: #969799;
}

.section-gap {
  height: 10px;
  background: #f7f8fa;
}

/* Vant Cell 调整，靠近系统风格 */
.van-cell {
  align-items: center;
}

.van-cell__title-text {
  font-size: 16px;
}

.van-icon {
  color: #969799;
}
